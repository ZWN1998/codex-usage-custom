{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-usage-custom",
  "version": "0.1.5",
  "description": "Customizable local Codex usage overlay for macOS Apple silicon.",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Codex Usage Custom",
        "brandColor": "#8C879F",
        "composerIcon": "./assets/codex-usage-icon.svg",
        "logo": "./assets/codex-usage-logo.png",
        "shortDescription": "可自定义位置、方向、字号和颜色的 Codex 用量浮窗。",
        "longDescription": "macOS Apple 芯片本地桌面浮窗。显示五小时及每周剩余额度、重置倒计时；支持左侧竖排、顶部横排、8–24 字号、自定义颜色和全屏定位。基于 Jay Hilwig 的 Codex Usage 修改，本包不是上游官方发行版。",
        "category": "Productivity",
        "capabilities": [
          "Interactive"
        ],
        "defaultPrompt": "启动 Codex Usage 浮窗",
        "developerName": "ZWN1998",
        "websiteURL": "https://github.com/ZWN1998/codex-usage-custom",
        "supportURL": "https://github.com/ZWN1998/codex-usage-custom/issues",
        "privacyPolicyURL": "https://github.com/ZWN1998/codex-usage-custom/blob/main/PRIVACY.md"
      }
    }
  },
  "author": {
    "name": "ZWN1998",
    "url": "https://github.com/ZWN1998"
  },
  "homepage": "https://github.com/ZWN1998/codex-usage-custom",
  "repository": "https://github.com/ZWN1998/codex-usage-custom"
}
